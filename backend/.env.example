# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/pia_db?schema=public"

# Secrets JWT
JWT_SECRET="votre-jwt-secret-tres-securise"
JWT_REFRESH_SECRET="votre-refresh-secret-tres-securise-different"

# CORS
FRONTEND_URL="*"

# Port du serveur
PORT=3000

# Hébergement groupé optionnel (après compilation de web, lancement depuis backend)
# WEB_DIST_DIR=../web/dist
# En production : deux secrets aléatoires distincts de 32 caractères minimum.
# FRONTEND_URL doit être l'origine HTTPS exacte, sans slash final.
# Sur Render, ne pas définir FRONTEND_URL : RENDER_EXTERNAL_URL est utilisé.
